{
  "name": "weekly-report-generator",
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "npm --prefix frontend --silent run lint:fix --",
      "npm --prefix frontend --silent run format --"
    ],
    "!(package-lock).json": "npm --prefix frontend --silent run format --",
    "*.md": "npm --prefix frontend --silent run format --"
  }
}
