# Root-level ignores for the weekly-report-generator monorepo.
# The frontend (Next.js) and backend (Spring Initializr) each keep their own
# .gitignore for stack-specific artifacts. This file covers what spans the repo
# or belongs at the root (e.g. tooling installed here in a later step).

# Node / frontend artifacts
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files (anywhere in the repo)
.env
.env.*
!.env.example

# IDE / editor folders
.vscode/
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db
