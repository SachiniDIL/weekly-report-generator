# Copy to .env and fill in real values. Do not commit .env.

# Backend database (defaults below match docker-compose.yml for local dev)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/weekly_report
SPRING_DATASOURCE_USERNAME=weekly_report
SPRING_DATASOURCE_PASSWORD=weekly_report

# Backend auth: signing key for issued JWTs
JWT_SECRET=your_jwt_secret

# Google Gemini (AI Studio, free tier): API key + a current model id, e.g. gemini-3.6-flash
# (older ids like gemini-2.0-flash / gemini-2.5-flash are 404 for new keys). Optional:
# GEMINI_TIMEOUT_SECONDS raises the read timeout (default 60) for slow reasoning responses.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Brevo: API key and the verified sender address for transactional email
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_brevo_sender_email

# Public URL of the frontend, used for CORS and links in outgoing email
FRONTEND_URL=http://localhost:3000

# Spring profiles. Leave empty for a plain run. Add "seed" once (e.g. "seed" locally,
# or "local,seed") to load the demo dataset via ProductionSeeder on the next boot;
# the seeder is idempotent, so remove it again afterwards.
# SPRING_PROFILES_ACTIVE=
